# sweb.env.<repo>.<version>.<spec_hash>
#
# Conda environment ("testbed") with the repo's test dependencies installed.
# Shared across every instance of the same repo+version. The image tag
# embeds a hash of (python, packages, pip_packages) so a spec change in
# swe_specs.py produces a new tag automatically — no manual invalidation.
#
# Deliberately contains NO repo checkout. Some pre_install steps (e.g.
# astropy's sed on pyproject.toml) need the repo present, so those run one
# layer up, in Dockerfile.eval, not here.

ARG BASE_IMAGE=sweb.base:latest
FROM ${BASE_IMAGE}

ARG REPO
ARG ENV_SETUP_COMMIT
ARG PYTHON_VERSION=3.11
ARG PACKAGES=""
ARG PIP_PACKAGES="pytest"

# ── Create the conda "testbed" env ───────────────────────────────────────────
# PACKAGES is one of:
#   "requirements.txt"   -> fetch that file from GitHub at ENV_SETUP_COMMIT,
#                            pip install -r it into a fresh env
#   "environment.yml"    -> fetch it, conda env create -f (python pinned to
#                            PYTHON_VERSION regardless of what's in the file)
#   "pkg1 pkg2 ..."      -> conda create with those packages directly
#   ""                   -> conda create with just the interpreter
RUN set -e; \
    case "${PACKAGES}" in \
      *.txt) \
        curl -fsSL "https://raw.githubusercontent.com/${REPO}/${ENV_SETUP_COMMIT}/${PACKAGES}" \
          -o /tmp/requirements.txt \
        && conda create -n testbed python=${PYTHON_VERSION} -y \
        && conda run -n testbed pip install -r /tmp/requirements.txt \
        ;; \
      *.yml|*.yaml) \
        curl -fsSL "https://raw.githubusercontent.com/${REPO}/${ENV_SETUP_COMMIT}/${PACKAGES}" \
          -o /tmp/environment.yml \
        && (sed -i "s/python=.*/python=${PYTHON_VERSION}/" /tmp/environment.yml || true) \
        && conda env create -n testbed -f /tmp/environment.yml \
        ;; \
      "") \
        conda create -n testbed python=${PYTHON_VERSION} -y \
        ;; \
      *) \
        conda create -n testbed python=${PYTHON_VERSION} ${PACKAGES} -y \
        ;; \
    esac \
    && conda clean -afy

# ── Pinned pip packages on top (applies after any of the branches above) ────
RUN conda run -n testbed pip install -U pip setuptools wheel

RUN if [ -n "${PIP_PACKAGES}" ]; then \
        eval "conda run -n testbed pip install ${PIP_PACKAGES}"; \
    fi

ENV PATH=/opt/conda/envs/testbed/bin:$PATH
WORKDIR /